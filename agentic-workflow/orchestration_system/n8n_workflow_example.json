    {
      "parameters": {
        "functionCode": "// Format the response\nconst response = {\n  success: true,\n  message: 'Workflow executed successfully',\n  timestamp: new Date().toISOString(),\n  data: $input.first().json\n};\n\nreturn [\n  {\n    json: response\n  }\n];"
